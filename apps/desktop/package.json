{
  "name": "@local-work-os/desktop",
  "version": "0.0.0",
  "description": "Local-only desktop work operating system for internal pilot use.",
  "author": "Pseudico",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "files": [
    "dist/**/*",
    "electron-builder.yml",
    "package.json"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "lint": "eslint src tests --ext .ts,.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts --passWithNoTests",
    "build": "electron-vite build",
    "package": "node scripts/package-development.mjs",
    "package:smoke": "node scripts/run-package-smoke.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "vite": "^7.3.2"
  }
}
